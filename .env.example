# Copy to .env (git-ignored) and fill in only what you use.

# Optional: enable the statistical anomaly layer.
# Values: 1/true/yes/on. Off by default.
SENTRY_ANOMALY_ENABLED=0

# Optional: JSON webhook for alert notifications (Slack/Teams/custom).
# Leave empty to disable notifications.
SENTRY_WEBHOOK_URL=
SENTRY_NOTIFY_MIN_SEVERITY=HIGH
SENTRY_NOTIFY_COOLDOWN_SECONDS=300

# Optional: AbuseIPDB reputation lookups.
# Create a key at https://www.abuseipdb.com/ and keep it out of version control.
ABUSEIPDB_API_KEY=
